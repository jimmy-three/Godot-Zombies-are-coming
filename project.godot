config_version=5

[application]

config/name="快打那些僵尸！"
run/main_scene="uid://dua65j126pv2l"
config/features=PackedStringArray("4.7", "Mobile")
config/icon="uid://bpoj2qx0y5k34"

[autoload]

Global="*uid://0kxbex4vijih"
BulletPool="*uid://b5g7fvmo4xlus"
ZombiePool="*uid://dlmhil358tu14"
CoinPool="*uid://ckex5xlsp6sno"

[display]

window/size/mode=3
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

